{
  "name": "iv-studio",
  "productName": "IV Studio",
  "version": "0.2.1",
  "description": "Infinite Variance studio for MiniMax H3: hunt previews, pick one, finish at 2 MP with DLSS. Built on ComfyUI, with an MCP server for agents.",
  "author": "Infinite Variance",
  "license": "MIT",
  "homepage": "https://infinitevariance.ai",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node test/graph-parity.mjs",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "release": "electron-vite build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "electron-updater": "6.8.9",
    "ffmpeg-ffprobe-static": "6.1.2-rc.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "ai.infinitevariance.studio",
    "productName": "IV Studio",
    "copyright": "Â© 2026 Infinite Variance",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IV Studio",
      "uninstallDisplayName": "IV Studio",
      "artifactName": "IV-Studio-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hollisorg",
        "repo": "iv-studio",
        "releaseType": "draft"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-ffprobe-static/**"
    ]
  }
}
